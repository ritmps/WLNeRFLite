#!/usr/bin/env python3
import os
import re
import subprocess
import sys

# Locate repo root
script_dir = os.path.dirname(os.path.abspath(__file__))
repo_root = os.path.dirname(script_dir)
paclet_info = os.path.join(repo_root, "PacletInfo.wl")

if not os.path.exists(paclet_info):
    sys.exit(0)

try:
    count = subprocess.check_output(
        ["git", "rev-list", "--count", "HEAD"],
        cwd=repo_root
    ).decode().strip()
    build_num = str(int(count) + 1)
except Exception:
    build_num = "1"

with open(paclet_info, "r", encoding="utf-8") as f:
    content = f.read()

if '"BuildNumber"' in content:
    new_content = re.sub(r'"BuildNumber"\s*->\s*"[^"]*"', f'"BuildNumber" -> "{build_num}"', content)
else:
    new_content = re.sub(r'("Version"\s*->\s*"[^"]*",)', rf'\1\n    "BuildNumber" -> "{build_num}",', content)

if new_content != content:
    with open(paclet_info, "w", encoding="utf-8") as f:
        f.write(new_content)
    subprocess.run(["git", "add", paclet_info], cwd=repo_root)
    print(f"[hook] Set PacletInfo.wl BuildNumber -> \"{build_num}\"")
