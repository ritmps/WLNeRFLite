#!/usr/bin/env wolframscript
(* ::Package:: *)
(* Git pre-commit hook and version management utility for WLNeRFLite.
   Automatically bumps the build number (Maj.Min.Build) on commit and syncs:
     - PacletInfo.wl ("Version" -> "X.Y.Z", "BuildNumber" -> "Z")
     - Kernel/init.wl ($WLNeRFLiteVersion = "X.Y.Z";)
     - Tests/NeRFLite.wlt ($WLNeRFLiteVersion === "X.Y.Z")
*)

If[Environment["SKIP_VERSION_BUMP"] === "1", Exit[0]];

scriptFile = Which[
  StringQ[$InputFileName] && $InputFileName =!= "", $InputFileName,
  ListQ[$ScriptCommandLine] && Length[$ScriptCommandLine] > 0, First[$ScriptCommandLine],
  True, ".githooks/pre-commit"
];

repoRoot = DirectoryName[ExpandFileName[scriptFile], 2];
pacletFile = FileNameJoin[{repoRoot, "PacletInfo.wl"}];
If[!FileExistsQ[pacletFile], Exit[0]];

isManual = AnyTrue[Rest[$ScriptCommandLine], MemberQ[{"--bump", "--force", "-f"}, #] &];

If[!isManual,
  stagedOut = Quiet @ Check[
    RunProcess[{"git", "diff", "--cached", "--name-only"}, "StandardOutput", ProcessDirectory -> repoRoot],
    ""
  ];
  stagedFiles = Select[StringSplit[StringTrim[stagedOut], "\n"], StringLength[#] > 0 &];
  nonVersionStaged = Select[
    stagedFiles,
    !(StringEndsQ[#, "PacletInfo.wl"] || StringStartsQ[#, ".githooks/"]) &
  ];
  If[Length[nonVersionStaged] == 0, Exit[0]];
];

content = Import[pacletFile, "Text"];
verMatch = StringCases[
  content,
  RegularExpression["\"Version\"\\s*->\\s*\"(\\d+)\\.(\\d+)(?:\\.(\\d+))?\""] :> {"$1", "$2", "$3"}
];
If[Length[verMatch] == 0, Exit[0]];

{majStr, minStr, bldStr} = First[verMatch];
major = ToExpression[majStr];
minor = ToExpression[minStr];
curBuild = If[StringLength[bldStr] > 0, ToExpression[bldStr], 0];

revCountStr = Quiet @ Check[
  StringTrim @ RunProcess[{"git", "rev-list", "--count", "HEAD"}, "StandardOutput", ProcessDirectory -> repoRoot],
  "0"
];
gitBuild = If[StringMatchQ[revCountStr, DigitCharacter ..], ToExpression[revCountStr] + 1, 1];
buildNum = Max[gitBuild, curBuild + 1];
verStr = ToString[major] <> "." <> ToString[minor] <> "." <> ToString[buildNum];

(* 1. Update PacletInfo.wl *)
newContent = StringReplace[
  content,
  {
    RegularExpression["\"Version\"\\s*->\\s*\"[^\"]+\""] -> "\"Version\" -> \"" <> verStr <> "\"",
    RegularExpression["\"BuildNumber\"\\s*->\\s*\"[^\"]+\""] -> "\"BuildNumber\" -> \"" <> ToString[buildNum] <> "\""
  }
];
Export[pacletFile, newContent <> "\n", "Text"];
Quiet @ RunProcess[{"git", "add", pacletFile}, ProcessDirectory -> repoRoot];

(* 2. Update Kernel/init.wl *)
initPath = FileNameJoin[{repoRoot, "Kernel", "init.wl"}];
If[FileExistsQ[initPath],
  initText = Import[initPath, "Text"];
  newInitText = StringReplace[
    initText,
    RegularExpression["(\\$WLNeRFLiteVersion\\s*=\\s*\")[^\"]+(\";)"] :> "$1" <> verStr <> "$2"
  ];
  If[newInitText =!= initText,
    Export[initPath, newInitText <> "\n", "Text"];
    Quiet @ RunProcess[{"git", "add", initPath}, ProcessDirectory -> repoRoot];
  ];
];

(* 3. Update Tests/NeRFLite.wlt *)
testPath = FileNameJoin[{repoRoot, "Tests", "NeRFLite.wlt"}];
If[FileExistsQ[testPath],
  testText = Import[testPath, "Text"];
  newTestText = StringReplace[
    testText,
    RegularExpression["(\\$WLNeRFLiteVersion\\s*===\\s*\")[^\"]+(\")"] :> "$1" <> verStr <> "$2"
  ];
  If[newTestText =!= testText,
    Export[testPath, newTestText <> "\n", "Text"];
    Quiet @ RunProcess[{"git", "add", testPath}, ProcessDirectory -> repoRoot];
  ];
];

Print["[hook] Bumped WLNeRFLite: Version -> \"", verStr, "\" (Build ", buildNum, ")"];
Exit[0];
